  <title>Political Quiz</title>

  <style>
    body {
      font-family: Arial;
      max-width: 800px;
      margin: auto;
      color: white;
      text-align: center;

      background: linear-gradient(to right,
        rgba(255,0,0,0.4) 50%,
        rgba(0,0,255,0.4) 50%
      ),
      linear-gradient(to bottom,
        rgba(255,255,0,0.4) 50%,
        rgba(0,255,0,0.4) 50%
      );
      background-blend-mode: multiply;
    }

    .container {
      background: rgba(0,0,0,0.75);
      padding: 20px;
      border-radius: 10px;
      margin-top: 20px;
    }

    .question {
      margin-bottom: 20px;
    }

    select, button {
      padding: 8px;
      margin-top: 5px;
      font-size: 14px;
    }

    .hidden {
      display: none;
    }

    img {
      max-width: 250px;
      border-radius: 10px;
    }
  </style>
